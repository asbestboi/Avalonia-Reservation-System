<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReservationSystem.ViewModels"
        x:Class="ReservationSystem.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Rezervační systém"
        Width="960" Height="680"
        MinWidth="700" MinHeight="500">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0D47A1"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0B3C8C"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Navigation bar -->
        <Border DockPanel.Dock="Top" Padding="16,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#1565C0"/>
                    <GradientStop Offset="1" Color="#1E88E5"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Rezervační systém"
                           VerticalAlignment="Center" FontSize="17"
                           FontWeight="Bold" Foreground="White" Margin="0,0,28,0"/>
                <Button Content="Rezervace"
                        Command="{Binding ShowReservationListCommand}"
                        Classes="nav"/>
                <Button Content="Kalendář"
                        Command="{Binding ShowCalendarCommand}"
                        Classes="nav"/>
                <Button Content="Nastavení"
                        Command="{Binding ShowSettingsCommand}"
                        Classes="nav"/>
            </StackPanel>
        </Border>

        <!-- Content switches via ViewLocator -->
        <ContentControl Content="{Binding CurrentView}"
                        Background="{StaticResource AppBackgroundBrush}"/>
    </DockPanel>
</Window>
