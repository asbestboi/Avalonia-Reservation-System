<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReservationSystem.ViewModels"
        x:Class="ReservationSystem.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Rezervační systém"
        Width="960" Height="680"
        MinWidth="700" MinHeight="500">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1565C0"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Navigation bar -->
        <Border DockPanel.Dock="Top" Background="#1976D2" Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Rezervační systém"
                           VerticalAlignment="Center" FontSize="16"
                           FontWeight="Bold" Foreground="White" Margin="0,0,24,0"/>
                <Button Content="Rezervace"
                        Command="{Binding ShowReservationListCommand}"
                        Classes="nav"/>
                <Button Content="Kalendář"
                        Command="{Binding ShowCalendarCommand}"
                        Classes="nav"/>
                <Button Content="Nastavení"
                        Command="{Binding ShowSettingsCommand}"
                        Classes="nav"/>
            </StackPanel>
        </Border>

        <!-- Content switches via ViewLocator -->
        <ContentControl Content="{Binding CurrentView}"/>
    </DockPanel>
</Window>
