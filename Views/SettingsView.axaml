<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReservationSystem.ViewModels"
             x:Class="ReservationSystem.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="18" Margin="40,28" MaxWidth="520">

            <TextBlock Text="Nastavení" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <!-- Karta s nastavenim -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <StackPanel Spacing="20">

                    <!-- Vychozi uzivatel -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Výchozí uživatel" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Předvyplní pole 'Rezervoval' při vytváření nové rezervace."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding Users}"
                                  SelectedItem="{Binding SelectedDefaultUser}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Vychozi delka rezervace -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Výchozí délka rezervace (minuty)" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <NumericUpDown Value="{Binding DefaultDuration}"
                                       Minimum="15" Maximum="480" Increment="15"
                                       HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Cesta k datum -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Umístění dat (AppData)" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox Text="{Binding AppDataPath}"
                                 IsReadOnly="True"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Zde jsou uloženy soubory rezervací, uživatelů a nastavení."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Soubory ulozene v AppData -->
            <Border Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="16" CornerRadius="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="Datové soubory:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="• reservations.txt – rezervace" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="• resources.txt   – prostředky (učebny, sportoviště…)" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="• users.txt       – seznam uživatelů" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="• settings.txt    – nastavení aplikace" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Stav -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource SuccessBrush}" FontSize="13"
                       IsVisible="{Binding StatusMessage,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Tlacitka -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="← Zpět"
                        Command="{Binding BackCommand}"
                        Padding="16,8"/>
                <Button Content="Uložit nastavení"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                        Padding="16,8"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
